<!DOCTYPE html>
<html>
  <head>
    <title>RailsPractice</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Critical CSS - Inlined for above-the-fold content -->
    <%= inline_critical_css %>
    
    <!-- Preload main CSS for faster loading -->
    <%= preload_critical_css %>
    
    <!-- Non-critical CSS loaded asynchronously -->
    <%= async_css_link_tag 'application' %>
    
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <div class="container">
      <header class="header">
        <nav class="navbar">
          <div class="navbar-brand">
            <h1>Rails Practice</h1>
          </div>
          <div class="navbar-nav">
            <%= link_to 'Home', root_path, class: 'btn' %>
          </div>
        </nav>
      </header>
      
      <main class="main-content">
        <%= yield %>
      </main>
      
      <footer class="footer">
        <div class="container">
          <p>&copy; <%= Date.current.year %> Rails Practice. All rights reserved.</p>
        </div>
      </footer>
    </div>
  </body>
</html>
